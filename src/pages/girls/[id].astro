---
import { getCollection } from "astro:content";
import BaseDetail from "../../layouts/BaseDetail.astro";
import { PAGES } from "../../config";
import ImageGrid from '../../components/ImageGrid.astro';

if (PAGES.girls.isActive === false) {
    return Astro.redirect("/404");
}

export async function getStaticPaths() {
    if (PAGES.girls.isActive === false) return [];
    const girls = await getCollection("girls");
    return girls.map((girl: any) => ({
        params: { id: girl.id },
        props: { girl },
    }));
}

const { id } = Astro.params;
const { Content } = await entry.render();
---

<BaseDetail collection="girls" id={id} />
<ImageGrid images={entry.data.images} columns={3} />
